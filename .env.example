# Port your agent (backend) listens on. The test runner defaults to it.
AGENT_PORT=8787

# Port the site (frontend, Vite) is served on. It forwards /agent/* and /api/* to AGENT_URL.
FRONTEND_PORT=3000

# The hosted sandbox. Leave the URL alone.
PLEC_SANDBOX_URL=https://api.plec.ai/hackathon/sandbox

# Your team's key. Copy it from https://plec.ai/hack/dashboard (it starts with hk_).
PLEC_SANDBOX_KEY=

# Your model access. Option 1 is the recommended one, and it is what the three
# lines below are already set up for.
#
# 1) PLEC's shared model proxy. PLEC lends its own Moonshot (Kimi) quota, so
#    you do not have to buy a key at the door. Mint your team's model key on
#    https://plec.ai/hack/dashboard (it starts with plk_) and paste it into
#    LLM_API_KEY. It is shown exactly once, so copy it then. The proxy is
#    shared across every team and capped per 5 minute window, and it stops
#    working when submissions close. Details: docs/model-proxy.md.
LLM_BASE_URL=https://api.plec.ai/hackathon/llm/v1
LLM_API_KEY=
LLM_MODEL=kimi-k2.6

# 2) Bring your own key, if you would rather not share the cap. Any
#    OpenAI-compatible chat completions endpoint works with agent/llm.js.
#    Replace the three lines above with the provider's base URL, your own key
#    and a model that provider serves.
#    OpenAI:     https://api.openai.com/v1
#    Anthropic:  https://api.anthropic.com/v1
#    Groq:       https://api.groq.com/openai/v1
#    DeepSeek:   https://api.deepseek.com/v1
#    Moonshot:   https://api.moonshot.ai/v1
#    Ollama:     http://localhost:11434/v1   (any key works)

# Where the test runner and the chat page send turns. Change only if your agent is not on AGENT_PORT.
AGENT_URL=http://localhost:8787

# Optional extras (PRD B). Each one is off while its variables are empty.
#
# Photo upload: reads the vibe of a photo the user attaches in the chat.
# ANTHROPIC_API_KEY=
# ANTHROPIC_VISION_MODEL=claude-opus-5
#
# Sending email for real (drafts and the mailto link work without these).
# Resend needs a verified sending domain; its test sender only delivers to
# the Resend account owner's own address.
# RESEND_API_KEY=
# EMAIL_FROM=PLEC Concierge <concierge@your-verified-domain.com>

# WhatsApp (optional): answer messages to the connected number through Meta's
# WhatsApp Cloud API. Expose the agent (AGENT_PORT) through an HTTPS tunnel,
# then in the Meta app under WhatsApp > Configuration set the callback URL to
# https://<your-tunnel>/api/webhooks/whatsapp and the verify token to
# WHATSAPP_VERIFY_TOKEN, and subscribe to the "messages" webhook field.
# Keep comments on their own lines: the .env reader takes the rest of a line as the value.
#
# Any string you choose; type the same one into Meta's webhook settings.
# WHATSAPP_VERIFY_TOKEN=
# App settings > Basic > App secret. Every delivery's signature is checked with it.
# WHATSAPP_APP_SECRET=
# WhatsApp > API Setup: the temporary token (24 hours) or a system user token.
# WHATSAPP_ACCESS_TOKEN=
# WhatsApp > API Setup > Phone number ID (not the phone number itself).
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_URL=https://graph.facebook.com/v23.0
