{
  "name": "plecathon-agent-template",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "npm --prefix frontend install --no-audit --no-fund",
    "start": "node backend/agent/server.js & npm --prefix frontend run dev",
    "backend": "node backend/agent/server.js",
    "frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test": "node backend/tests/run.js",
    "test:unit": "node --test \"backend/tests/unit/**/*.test.js\""
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0"
  }
}
